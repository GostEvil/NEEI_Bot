# ============================================================
# NEEI Bot - Ficheiro de Configuração (Copiar para .env)
# ============================================================

# Token do bot (obtido no Discord Developer Portal)
DISCORD_TOKEN=o_teu_token_aqui

# ID da aplicação do bot (Client ID no Developer Portal)
CLIENT_ID=o_teu_client_id_aqui

# ID do servidor Discord onde o bot vai operar
GUILD_ID=o_id_do_teu_servidor_aqui

# IDs dos Managers separados por vírgula (sem espaços)
# Exemplo: MANAGER_IDS=123456789012345678,987654321098765432
MANAGER_IDS=teu_user_id,outro_manager_user_id

# Nome exato do cargo/role no servidor Discord
NEEI_ROLE_NAME=NEEI

# (Opcional) ID do canal de destino para enviar imagens via /sayimage
TARGET_CHANNEL_ID=id_do_canal_aqui

# (Opcional) ID do cargo de verificação (configurável via comando /config)
VERIFY_ROLE_ID=id_do_cargo_de_verificacao

# ─────────────────────────────────────────────────────────────
# Verificação 1 — Certificado Multiusos do IPB
# ─────────────────────────────────────────────────────────────

# (Opcional) ID do canal onde o comando /verificacao1 pode ser usado.
# Se não definido, o comando funciona em qualquer canal.
CERTIFICATE_VERIFICATION_CHANNEL_ID=id_do_canal_verificacao

# (Obrigatório para logs) ID do canal PRIVADO onde os logs de verificação são enviados.
# Este canal deve ser acessível apenas a administradores — contém dados pessoais.
CERTIFICATE_VERIFICATION_LOG_CHANNEL_ID=id_do_canal_log_privado
